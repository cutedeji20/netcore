# .env.example — BUILD.md §105
# Copy to .env for local dev. NEVER commit a real .env (§1.17).
# Production secrets come from the secret store (§68), not from this file.

NETCORE_ENV=development
NETCORE_SERVICE_NAME=netcore-api
NETCORE_HTTP_ADDR=:8080

# --- Database -------------------------------------------------------------
NETCORE_DB_DSN=postgres://netcore:netcore_dev_only@localhost:5432/netcore?sslmode=disable
NETCORE_DB_MAX_CONNS=25
NETCORE_DB_STATEMENT_TIMEOUT=10s
NETCORE_DB_CONNECT_TIMEOUT=5s

# --- Redis ----------------------------------------------------------------
# Cache and rate limiting only. Never the source of truth (§37).
# Not a readiness gate (§48).
NETCORE_REDIS_ADDR=localhost:6379
# Leave empty for the local development Redis container. Production must use
# NETCORE_REDIS_PASSWORD_FILE, a read-only mounted secret, instead.
NETCORE_REDIS_PASSWORD=
NETCORE_REDIS_TIMEOUT=250ms

# --- Security -------------------------------------------------------------
# Comma-separated. MUST NOT be '*' in production — the process refuses to
# start (§1.19, §57, §105).
NETCORE_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Production: comma-separated Caddy IP/CIDR values only. X-Forwarded-For is
# ignored unless the direct peer is on this list.
NETCORE_TRUSTED_PROXIES=
NETCORE_TLS_SKIP_VERIFY=false
NETCORE_SEED_ENABLED=true

# §82.3: this IS your outage exposure window. During a total control-plane
# outage, existing sessions survive until this expires. Capped at 24h in
# production.
NETCORE_SESSION_TIMEOUT=4h

# --- Authentication --------------------------------------------------------
# Argon2id. Parameters are stored in PHC hashes and upgraded on successful
# login, so raising these values does not invalidate existing credentials.
NETCORE_AUTH_SESSION_TTL=24h
NETCORE_AUTH_PASSWORD_MEMORY_KIB=65536
NETCORE_AUTH_PASSWORD_ITERATIONS=3
NETCORE_AUTH_PASSWORD_PARALLELISM=2
# Production refuses to start unless this is true. It keeps a valid password
# from becoming a browser session until a replay-safe authenticator code also
# succeeds.
NETCORE_AUTH_REQUIRE_MFA=false

# --- Quota (§21A) ---------------------------------------------------------
# Worst-case unbilled window per session == the interim interval.
# Floor is 60s in every environment: below that is an accounting flood.
NETCORE_QUOTA_INTERIM_BASE=300s
NETCORE_QUOTA_INTERIM_FINE=60s

# Per-session budget cap (§21A.3). Keeps a session that fails to report from
# claiming the whole balance.
NETCORE_QUOTA_MAX_SESSION_BYTES=2147483648

# v1.2 asymptote guard: below this, grant the whole remainder instead of
# slicing it into fragments the customer can never consume.
NETCORE_QUOTA_MIN_SESSION_BYTES=33554432

# Reaper grace on top of 3 missed interim updates (§24A.3).
NETCORE_QUOTA_REAPER_GRACE=60s

# --- Limits (§16) ---------------------------------------------------------
NETCORE_MAX_REQUEST_BYTES=262144
NETCORE_MAX_WEBHOOK_BYTES=65536
NETCORE_MAX_PAGE_SIZE=100
NETCORE_DEFAULT_PAGE_SIZE=25
NETCORE_HANDLER_TIMEOUT=15s
NETCORE_MAX_JSON_ARRAY=1000
NETCORE_SHUTDOWN_GRACE=20s

# --- Secrets (§68) --------------------------------------------------------
# sops (Phase 1) or vault (after §68.4 fires).
# This is a REFERENCE, never a secret value.
NETCORE_SECRETS_BACKEND=sops
NETCORE_SECRETS_REF=netcore/development

# --- Payments -------------------------------------------------------------
# Disabled is safe by default. Set `paystack` only after the SOPS-decrypted
# secret document is mounted and contains this logical key; never put its
# value in this file or in an environment variable.
NETCORE_PAYMENT_GATEWAY=disabled
NETCORE_PAYSTACK_SECRET_REF=payments.paystack.secret_key

# The webhook receiver stores a signed event first; the worker later verifies
# it server-to-server. These control the worker's bounded recovery behaviour.
NETCORE_WEBHOOK_POLL_INTERVAL=1s
NETCORE_WEBHOOK_MAX_ATTEMPTS=8
