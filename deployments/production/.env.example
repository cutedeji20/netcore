# Public deployment values only. Copy to .env on the Kamatera host.
# Do not place passwords, DSNs, API keys, RADIUS secrets or Paystack keys here.
NETCORE_DOMAIN=netcore.example.com
NETCORE_RUNTIME_DIR=/srv/netcore/runtime
# Leave locked until the MFA-enforced first administrator ceremony succeeds.
NETCORE_UI_MODE=locked
# NETCORE_TENANT_SLUG=your-lowercase-tenant-slug
# The dashboard signs an operator out at this absolute maximum. Do not use a
# multi-day value on a production control dashboard.
NETCORE_AUTH_SESSION_TTL=8h
NETCORE_PAYMENT_GATEWAY=disabled
# Keep device replacement off until migrations, RADIUS, e-mail delivery, and
# a bridged-AP pilot have all been accepted.
NETCORE_DEVICE_REPLACEMENT_ENABLED=false

# Public browser entry point for staff invitations. This is not a secret: it
# must be an HTTPS URL on the same origin as the production dashboard.
NETCORE_STAFF_INVITE_URL=https://netcore.example.com/staff-invite.html

# Leave this disabled until the Azure Key Vault KEK, the VM's managed identity,
# private endpoint, and RBAC role assignment are all ready. This file contains
# only the versioned key identifier; Resend and Squad keys are entered in
# the staff dashboard and encrypted in PostgreSQL.
NETCORE_INTEGRATION_CRYPTO_BACKEND=disabled
# NETCORE_INTEGRATION_KEK_ID=https://netcore-vault.vault.azure.net/keys/netcore-integrations-kek/<version>

# The private VPN/control-plane address that routers use to reach FreeRADIUS.
# Do not use the public VM IP and do not expose UDP 1812/1813 to the internet.
NETCORE_RADIUS_SERVER_ADDRESS=172.16.0.4

# RADIUS stays in its separate "radius" Compose profile until a non-production
# NAS acceptance run completes. Put this on a dedicated, monitored filesystem.
NETCORE_RADIUS_SPOOL_DIR=/srv/netcore/radius-spool
NETCORE_RADIUS_SPOOL_MAX_BYTES=5368709120
NETCORE_RADIUS_SPOOL_MIN_FREE_BYTES=1073741824
