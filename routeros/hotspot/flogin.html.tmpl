<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="referrer" content="no-referrer" />
    <meta http-equiv="cache-control" content="no-store" />
    <title>NetCore Wi-Fi needs attention</title>
    <style>
      body { margin: 0; background: #07131f; color: #ecf5ff; font: 16px/1.5 system-ui, sans-serif; }
      main { max-width: 34rem; margin: 12vh auto; padding: 2rem; }
      .card { padding: 2rem; border: 1px solid #29506b; border-radius: 1rem; background: #0b1d2c; }
      a { display: inline-block; margin-top: 1rem; padding: .75rem 1rem; border-radius: .65rem; color: #062036; background: #75dfc2; font-weight: 700; text-decoration: none; }
      p { color: #bed2e2; }
    </style>
  </head>
  <body>
    <main>
      <section class="card" aria-labelledby="title">
        <h1 id="title">We could not connect this device yet</h1>
        <p>Your plan may have ended, the sign-in link may have expired, or the Wi-Fi service is briefly busy.</p>
        <p>Return to the NetCore portal to sign in, renew, or choose a plan. No payment is taken from this page.</p>
        <a href="$(link-login-only)">Open NetCore portal again</a>
      </section>
    </main>
  </body>
</html>
