<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="referrer" content="no-referrer" />
    <meta http-equiv="cache-control" content="no-store" />
    <title>NetCore Wi-Fi maintenance</title>
    <style>
      body { margin: 0; background: #07131f; color: #ecf5ff; font: 16px/1.5 system-ui, sans-serif; }
      main { max-width: 34rem; margin: 12vh auto; padding: 2rem; }
      .card { padding: 2rem; border: 1px solid #29506b; border-radius: 1rem; background: #0b1d2c; }
      p { color: #bed2e2; }
      small { color: #88a8bc; }
    </style>
  </head>
  <body>
    <main>
      <section class="card" aria-labelledby="title">
        <h1 id="title">NetCore Wi-Fi is being updated</h1>
        <p>New sign-ins are temporarily paused while we make the service safer and more reliable.</p>
        <p>Please reconnect in a few minutes. You will not be charged while this maintenance page is shown.</p>
        <small>This page is served directly by the local router.</small>
      </section>
    </main>
  </body>
</html>
