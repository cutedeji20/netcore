<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="referrer" content="no-referrer" />
    <meta http-equiv="cache-control" content="no-store" />
    <title>NetCore Wi-Fi is temporarily unavailable</title>
    <style>
      body { margin: 0; background: #07131f; color: #ecf5ff; font: 16px/1.5 system-ui, sans-serif; }
      main { max-width: 34rem; margin: 12vh auto; padding: 2rem; }
      .card { padding: 2rem; border: 1px solid #29506b; border-radius: 1rem; background: #0b1d2c; }
      a { display: inline-block; margin-top: 1rem; padding: .75rem 1rem; border-radius: .65rem; color: #062036; background: #75dfc2; font-weight: 700; text-decoration: none; }
      p { color: #bed2e2; }
    </style>
  </head>
  <body>
    <main>
      <section class="card" aria-labelledby="title">
        <h1 id="title">Wi-Fi sign-in is temporarily unavailable</h1>
        <p>The local network is working, but it cannot complete a sign-in right now.</p>
        <p>Please wait a moment, then try again. Existing connected devices are not changed by this page.</p>
        <a href="$(link-login-only)">Try sign-in again</a>
      </section>
    </main>
  </body>
</html>
